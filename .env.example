# Copy to .env: the npm scripts load it with `node --env-file=.env` (Node 20.6+).
# Without a .env file, export these in your shell and run `node dist/src/main.js` directly.
DATABASE_URL=postgres://ledger:ledger@localhost:5433/ledger
# Ethereum network id (net_version). 1 = main network.
NETWORK_ID=1
# A JSON-RPC endpoint (geth/Parity), ideally an archive node or one with recent state.
RPC_URL=http://localhost:8545
# Comma-separated ERC-20 contracts. Fixed for the life of the database (see README).
TOKENS=0x0000000000000000000000000000000000000001
# Deployment block of the EARLIEST token. Balances are only correct if you index from deployment.
START_BLOCK=1
CONFIRMATIONS=12
MAX_REORG_DEPTH=256
POLL_INTERVAL_MS=4000
MAX_BLOCKS_PER_TICK=200
RECONCILE_INTERVAL_MS=900000
API_PORT=8080
# Required to enable POST /ingest. Leave unset to disable the endpoint.
INGEST_TOKEN=
