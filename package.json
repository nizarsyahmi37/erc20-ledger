{
  "name": "erc20-ledger",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "ERC-20 Transfer indexer with confirmations, reorg handling and on-chain reconciliation",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "dev": "node --env-file=.env --watch src/main.ts",
    "start": "node --env-file=.env dist/main.js",
    "migrate": "node --env-file=.env dist/migrate.js",
    "rebuild-balances": "node --env-file=.env dist/rebuild.js",
    "test": "npm run typecheck && node --test --test-concurrency=1 test/*.test.ts",
    "coverage": "node --test --test-concurrency=1 --experimental-test-coverage --test-coverage-include='src/**/*.ts' --test-coverage-exclude=src/main.ts --test-coverage-exclude=src/rebuild.ts --test-coverage-lines=80 test/*.test.ts"
  },
  "dependencies": {
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2"
  }
}
