{
  "name": "erc20-ledger",
  "version": "0.3.0",
  "private": true,
  "description": "ERC-20 Transfer indexer with confirmations, reorg handling and on-chain reconciliation",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "tsc -p .",
    "start": "node dist/src/main.js",
    "migrate": "node dist/src/migrate.js",
    "rebuild-balances": "node dist/src/rebuild.js",
    "test": "npm run build && mocha dist/test"
  },
  "dependencies": {
    "pg": "8.5.1"
  },
  "devDependencies": {
    "@types/mocha": "8.2.1",
    "@types/node": "20.11.16",
    "@types/pg": "7.14.10",
    "mocha": "8.3.0",
    "typescript": "5.3.3"
  }
}
