{
  "name": "erc20-ledger",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "ERC-20 Transfer indexer with confirmations, reorg handling and on-chain reconciliation",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "tsc -p .",
    "start": "node --env-file=.env dist/src/main.js",
    "migrate": "node --env-file=.env dist/src/migrate.js",
    "rebuild-balances": "node --env-file=.env dist/src/rebuild.js",
    "test": "npm run build && node --test --test-concurrency=1 dist/test/*.test.js"
  },
  "dependencies": {
    "pg": "8.11.3"
  },
  "devDependencies": {
    "@types/node": "20.11.16",
    "@types/pg": "8.11.0",
    "typescript": "5.3.3"
  }
}
